<!DOCTYPE html>
<html lang="vi">
<%- include('../partials/head', { title: 'Cài đặt' }) %>
<body>
<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'settings', admin: admin }) %>

  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-eyebrow">Hệ thống</div>
        <h1>Cài đặt</h1>
      </div>
    </div>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <div class="panel" id="ai">
      <h2 class="panel-title">Cấu hình AI (Gemini)</h2>
      <p class="hint">
        API key được mã hóa khi lưu và không bao giờ hiển thị lại đầy đủ.
        Thay đổi có hiệu lực trong vòng 30 giây, không cần khởi động lại backend.
      </p>

      <div class="kv">
        <span>Trạng thái key</span>
        <% if (ai.hasKey) { %>
          <span class="badge badge-active">Đã cấu hình</span>
          <span class="mono"><%= ai.apiKeyMasked %></span>
          <span class="hint">(nguồn: <%= ai.apiKeySource === 'database' ? 'Web Admin' : 'file .env' %>)</span>
        <% } else { %>
          <span class="badge badge-inactive">Chưa có key</span>
          <span class="hint">Tab AI trên app sẽ không hoạt động</span>
        <% } %>
      </div>

      <form method="POST" action="/settings/ai" autocomplete="off">
        <div class="form-group" style="margin-bottom: 12px;">
          <label for="apiKey">Gemini API key mới</label>
          <input type="password" id="apiKey" name="apiKey" placeholder="<%= ai.hasKey ? 'Để trống để giữ key hiện tại' : 'AIza...' %>" autocomplete="new-password" />
        </div>
        <div class="form-row" style="margin-bottom: 12px;">
          <div class="form-group">
            <label for="model">Model</label>
            <input type="text" id="model" name="model" value="<%= ai.model %>" placeholder="gemini-2.0-flash" />
          </div>
          <div class="form-group">
            <label for="maxInputChars">Giới hạn ký tự đầu vào / lần gọi</label>
            <input type="number" id="maxInputChars" name="maxInputChars" min="500" max="100000" value="<%= ai.maxInputChars %>" />
          </div>
        </div>
        <% if (ai.apiKeySource === 'database') { %>
          <label class="check"><input type="checkbox" name="clearKey" /> Xóa key đã lưu (quay về key trong .env nếu có)</label>
        <% } %>
        <div class="btn-row">
          <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
          <button type="submit" class="btn btn-ghost" formaction="/settings/ai/test">Kiểm tra kết nối</button>
        </div>
      </form>
    </div>

    <div class="panel" id="password">
      <h2 class="panel-title">Đổi mật khẩu</h2>
      <p class="hint">Tài khoản: <span class="mono"><%= admin?.email %></span></p>
      <form method="POST" action="/settings/password" autocomplete="off">
        <div class="form-group" style="margin-bottom: 12px;">
          <label for="oldPassword">Mật khẩu hiện tại</label>
          <input type="password" id="oldPassword" name="oldPassword" required autocomplete="current-password" />
        </div>
        <div class="form-row" style="margin-bottom: 12px;">
          <div class="form-group">
            <label for="newPassword">Mật khẩu mới (tối thiểu 6 ký tự)</label>
            <input type="password" id="newPassword" name="newPassword" minlength="6" required autocomplete="new-password" />
          </div>
          <div class="form-group">
            <label for="confirmPassword">Nhập lại mật khẩu mới</label>
            <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required autocomplete="new-password" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
      </form>
    </div>
  </main>
</div>
</body>
</html>
