# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/language_app

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Gemini (AI assistant). Giá trị dự phòng: admin có thể nhập/đổi API key, model trong
# Web Admin → Cài đặt (lưu mã hóa vào DB, ưu tiên hơn .env). Để trống để tắt tab AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used by seed/createAdmin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin

# (Tùy chọn) Khóa mã hóa API key lưu trong DB. Mặc định dẫn xuất từ JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=
