# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/language_app

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Gemini (AI assistant: chat + summaries). Can also be set from the admin web "Settings" page.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used by seed/createAdmin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrator
